# Device-side secrets/config for pda2 (SPIFFS: /env.cfg)
#
# Copy to /env.cfg ON THE DEVICE (this example is tracked, the real
# file never is). Lookup chain for each value:
#   NVS (highest priority) -> /env.cfg -> config_keys.h (gitignored)
#   -> built-in default
# When NVS already holds a value (e.g. saved from the AI Config screen),
# the /env.cfg entry is ignored for that key.
#
# Format: KEY=VALUE, '#' starts a comment. Max 8 entries, value <= 95 chars.

# OpenRouter API key (AI Text / AI Config)
# AI_KEY=sk-or-v1-...

# OpenWeatherMap API key (Weather)
# OWM_KEY=...

# Default location used when GPS has no fix, e.g. Shenzhen:
# WEATHER_COORDS=lat=22.5431&lon=114.0579
